@model MoviesAdmin.Models.CriticReview
@{
    ViewData["Title"] = "Create Critic Review";
}

<h1>Create Critic Review</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MovieId" />
            
        
            <div class="form-group mb-3">
                <label class="control-label fw-bold">Movie</label>
                <input class="form-control" value="@Model.Movie?.Title" readonly />
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            
     
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Write your review text (max 1000 characters)..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            
       
            <div class="form-group mb-3">
                <label asp-for="Rating" class="control-label">Rating (0-5)</label>
                <input asp-for="Rating" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            
            <div class="form-check mb-3">
                <input asp-for="IsPublished" class="form-check-input" id="IsPublished" />
                <label asp-for="IsPublished" class="form-check-label"></label>
            </div>
            
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-controller="Movies" asp-action="Details" asp-route-id="@Model.MovieId" class="btn btn-secondary">Back to Movie</a>
        </form>
    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            $('form').submit(function (e) {
                if ($('#IsPublished').is(':checked')) {
                    var confirmPublish = confirm("Warning: You will not be able to edit or delete this review once you publish it. Do you want to proceed?");
                    if (!confirmPublish) {
                        e.preventDefault();
                    }
                }
            });
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
