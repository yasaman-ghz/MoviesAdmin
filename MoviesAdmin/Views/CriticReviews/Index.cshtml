@model IEnumerable<MoviesAdmin.Models.CriticReview>
@{
    ViewData["Title"] = "Critic Reviews";
}

<h1>Critic Reviews</h1>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Movie</th>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.Rating)</th>
            <th>@Html.DisplayNameFor(model => model.IsPublished)</th>
            @* <th>@Html.DisplayNameFor(model => model.CreatedBy)</th> *@
            <th>@Html.DisplayNameFor(model => model.CreatedDate)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Movie?.Title</td>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.Rating) / 5</td>
                <td>
                    <span class="badge @(item.IsPublished ? "bg-success" : "bg-warning text-dark")">
                        @(item.IsPublished ? "Published" : "Draft")
                    </span>
                </td>
                @* <td>@Html.DisplayFor(modelItem => item.CreatedBy)</td> *@
                <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                <td>
                    <!-- Details is always visible to the owner critic -->
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Details</a>
                    
                    <!-- Requirement 7 & B: Edit and Delete are only rendered if the review remains an unpublished draft -->
                    @if (!item.IsPublished)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
