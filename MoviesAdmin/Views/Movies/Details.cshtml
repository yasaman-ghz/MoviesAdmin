@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div>
    <hr />
    <div class="row mb-4">
        <div class="col-sm-3 text-center">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Cover Photo" class="details-thumbnail shadow-sm rounded" style="max-width: 100%; height: auto;" />
            }
        </div>
        <div class="col-sm-9">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Genre)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Genre.Title)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Synopsis)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Synopsis)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AudienceRating)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.AudienceRating.Title)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Runtime)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Runtime) mins</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ReleaseDate)</dt>
                <dd class="col-sm-9">@Model.ReleaseDate.ToString("yyyy-MM-dd")</dd>

                <!-- Requirement 9 & Requirement A: Displays the total published review count -->
                <dt class="col-sm-3">Total Critic Reviews</dt>
                <dd class="col-sm-9"><span class="badge bg-info text-dark">@ViewBag.ReviewsCount published reviews</span></dd>
            </dl>
        </div>
    </div>
</div>

<div class="mt-3">
    @if (User.IsInRole("administrator"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-success"><i class="bi bi-pencil"></i></a> 
    }
    @if (User.IsInRole("critic"))
    {
        <!-- Requirement B & 14: Let critics directly initiate review drafting pipelines -->
        <a asp-controller="CriticReviews" asp-action="Create" asp-route-movieId="@Model?.Id" class="btn btn-primary"><i class="bi bi-plus"></i> Add a Review</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to all</a>
</div>
