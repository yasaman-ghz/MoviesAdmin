@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Results";
}

<h1>Results:</h1>


@*Search bar reference: https://www.youtube.com/watch?v=5-fVog2hd5c*@
<form asp-controller="Movies" asp-action="Search" method="get" class="d-flex" style="max-width: 350px;">
    <div class="input-group">  @*Reference: https://codeconvey.com/bootstrap-5-search-bar-with-icons/*@
        <input 
            type="search" 
            class="form-control" 
            name="searchString" 
            placeholder="Search by title..." 
            aria-label="Search by title"
        />
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i>
        </button>
    </div>
</form>

<p>
<a asp-action="Index"><button type="submit" class="btn btn-primary" style="margin-top: 10px;">Back to all</button></a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Synopsis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageFilename)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre)
            </td>
            <td>
                    @item.Synopsis.Substring(0, 30)<a asp-action="Details" asp-route-id="@item.Id">...more</a>
            </td>
            <td>
                @Html.DisplayFor(model => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(model => item.ImageFilename)
            </td>
            <td>
                @Html.DisplayFor(model => item.Runtime)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id"><button type="submit" class="btn btn-success"><i class="bi bi-pencil"></i></button></a> 
                <a asp-action="Details" asp-route-id="@item.Id"><button type="submit" class="btn btn-secondary"><i class="bi bi-three-dots"></i></button></a> 
                <a asp-action="Delete" asp-route-id="@item.Id"><button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i></button> </a>
            </td>
        </tr>
}
    </tbody>
</table>
