@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="GenreId" class="form-label fw-bold">Genre</label>
                <select asp-for="GenreId" class="form-select" asp-items="ViewBag.GenreId"></select>
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Synopsis" class="form-label fw-bold"></label>
                <textarea style="resize: none;" asp-for="Synopsis" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Synopsis" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="AudienceRatingId" class="form-label fw-bold">Audience Rating</label>
                <select asp-for="AudienceRatingId" class="form-select" asp-items="ViewBag.AudienceRatingId"></select>
                <span asp-validation-for="AudienceRatingId" class="text-danger"></span>
            </div>

         
            <div class="mb-3 card p-3 bg-light">   
                <label class="form-label fw-bold text-secondary">Current Cover Photo:</label>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.ImageUrl" alt="Cover Photo" class="details-thumbnail rounded border" style="max-height: 180px; width: auto;" />
                    </div>
                }
                <label for="coverPhoto" class="form-label fw-bold">Change poster photo:</label>
                <input type="file" name="coverPhoto" id="coverPhoto" class="form-control" accept="image/*" />
            </div>

            <div class="mb-3">
                <label asp-for="Runtime" class="form-label fw-bold">Runtime (Minutes)</label>
                <input asp-for="Runtime" class="form-control" />
                <span asp-validation-for="Runtime" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="ReleaseDate" class="form-label fw-bold"></label>
                <input asp-for="ReleaseDate" class="form-control" type="date" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>
            
            <div class="pt-2">
                <button type="submit" class="btn btn-success">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back to all</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
