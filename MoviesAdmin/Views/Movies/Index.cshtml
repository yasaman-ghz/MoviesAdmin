@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>All movies:</h1>


@*Search bar reference: https://youtube.com*@
<form asp-controller="Movies" asp-action="Search" method="get" class="d-flex" style="max-width: 350px;">
    <div class="input-group">  @*Reference: https://codeconvey.com*@
        <input 
            type="search" 
            class="form-control" 
            name="searchString" 
            placeholder="Search by title..." 
            aria-label="Search by title"
        />
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i>
        </button>
    </div>
</form>

@if (User.IsInRole("administrator"))
{
    <p>
        <a asp-action="Create"><button type="submit" class="btn btn-primary" style="margin-top: 10px;"><i class="bi bi-plus"></i>Add</button></a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
               @*this is just to have an extra column.*@
            </th>
            <th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Synopsis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AudienceRating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <img src="@item.ImageUrl" alt="Cover Photo" class="index-thumbnail" />
            </td>
            <td>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre.Title)
            </td>
            <td>
                    @item.Synopsis.Substring(0, 30)<a asp-action="Details" asp-route-id="@item.Id">...more</a>
            </td>
            <td>
                @Html.DisplayFor(model => item.AudienceRating.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Runtime)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            <td>
                @if (User.IsInRole("administrator"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success"><i class="bi bi-pencil"></i></a> 
                }
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary"><i class="bi bi-three-dots"></i></a> 
                @if (User.IsInRole("administrator"))
                {
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger"><i class="bi bi-trash"></i></a>
                }

            </td>
        </tr>
}
    </tbody>
</table>
