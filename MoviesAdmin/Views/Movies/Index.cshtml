@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>Movies:</h1>


@*Search bar reference: https://www.youtube.com/watch?v=5-fVog2hd5c*@
<form asp-controller="Movies" asp-action="Index" method="get">
    <input type="search" class="form-control" name="searchString" placeholder="Search by title..." style="width:300px; margin-top: 10px;" />
    <input type="submit" value=" Search / Back to all " class="btn btn-primary" style="margin-top: 10px; margin-bottom: 10px;" />
</form>

<p>
    <a asp-action="Create">Create a new record</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Synopsis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageFilename)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre)
            </td>
            <td>
                    @item.Synopsis.Substring(0, 30) ...(<a asp-action="Details" asp-route-id="@item.Id">more</a>)
            </td>
            <td>
                @Html.DisplayFor(model => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(model => item.ImageFilename)
            </td>
            <td>
                @Html.DisplayFor(model => item.Runtime)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
